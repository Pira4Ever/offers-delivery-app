<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OffersDelivery.ViewModels"
             x:Class="OffersDelivery.MainPage">
    <ContentPage.BindingContext>
        <local:MarketsViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">
        <CollectionView Grid.Row="1" ItemsSource="{Binding Markets}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                Orientation="Vertical"
                Span="2"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="8"
                        Padding="10"
                        StrokeThickness="1"
                        Stroke="#DDDDDD"
                        StrokeShape="RoundRectangle 12">
                        <ImageButton Source="{Binding Url}" HeightRequest="100" WidthRequest="100" CommandParameter="{Binding EncodedName}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ChangePageCommand}"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
